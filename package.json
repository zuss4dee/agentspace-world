{
  "name": "agentspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43141",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43141",
    "lint": "eslint",
    "blender:publish": "node scripts/blender/publish.mjs",
    "blender:build-company": "node scripts/blender/build-company.mjs",
    "blender:generate-building": "node scripts/blender/build-company.mjs",
    "building:generate": "blender --background scripts/blender/agentspace-world-multitask.blend --python scripts/blender/generate_building.py --",
    "building:test": "PYTHONPATH=scripts/blender python3 -m unittest agentspace.test_generator_contract",
    "logo:build": "blender --background scripts/blender/agentspace-world-multitask.blend --python scripts/blender/build_logo.py --",
    "brand:resolve": "tsx scripts/resolve-brand-assets.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
